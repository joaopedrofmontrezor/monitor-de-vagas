# Copie para .env (Copy-Item .env.example .env) e ajuste se precisar.
# O .env está no .gitignore: segredo de verdade nunca vai para o repositório.

AMBIENTE=local
LOG_LEVEL=INFO

# --- Postgres (usado pelo serviço db do compose) ---
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=monitor_vagas
# Troque se já tiver um Postgres instalado usando a 5432 no seu Windows
POSTGRES_PORTA=5432

# --- API ---
API_PORTA=8000

# URL para rodar pytest/uvicorn FORA do Docker (no seu terminal).
# Dentro do compose ela é sobrescrita para apontar para o host "db".
DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/monitor_vagas

# --- Worker (issue #4) ---
# Intervalo entre coletas, em horas, para TODOS os coletores (mínimo 6, ADR-0003).
# Sem esta variável, cada coletor usa o próprio intervalo_horas. Descomente para usar.
# COLETA_INTERVALO_HORAS=12

# --- Coletor do Greenhouse (issue #8) ---
# Tokens das empresas separados por vírgula. Vazio = lista padrão (36 empresas,
# ver EMPRESAS_PADRAO em backend/app/coletores/greenhouse.py). Ex.: btgpactual,inter
GREENHOUSE_EMPRESAS=

# --- Telegram (issue #11) ---
# Token do bot gerado pelo @BotFather. Cada um cria o próprio bot de teste.
TELEGRAM_BOT_TOKEN=
