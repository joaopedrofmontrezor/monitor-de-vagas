# Copie para .env (Copy-Item .env.example .env) e ajuste se precisar.
# O .env está no .gitignore: segredo de verdade nunca vai para o repositório.

AMBIENTE=local
LOG_LEVEL=INFO

# --- Postgres (usado pelo serviço db do compose) ---
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=monitor_vagas
# Troque se já tiver um Postgres instalado usando a 5432 no seu Windows
POSTGRES_PORTA=5432

# --- API ---
API_PORTA=8000

# URL para rodar pytest/uvicorn FORA do Docker (no seu terminal).
# Dentro do compose ela é sobrescrita para apontar para o host "db".
DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/monitor_vagas
